{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulation-ontology.example/schema/predicate-authoring-v0.1.schema.json",
  "title": "SOL Predicate Authoring v0.1",
  "description": "Authoring syntax for ADR-0023 Compare, Membership, Exists, and Boolean predicates. Numeric lexeme capture and reference resolution are compiler responsibilities.",
  "$defs": {
    "scalar": {
      "type": ["number", "string", "boolean"]
    },
    "compare": {
      "type": "object",
      "required": ["predicate", "ref", "op", "value"],
      "properties": {
        "predicate": {"const": "compare"},
        "ref": {"type": "string", "minLength": 1},
        "op": {"enum": ["eq", "ne", "lt", "le", "gt", "ge"]},
        "value": {"$ref": "#/$defs/scalar"}
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"enum": ["lt", "le", "gt", "ge"]}}, "required": ["op"]},
          "then": {"properties": {"value": {"type": "number"}}}
        }
      ],
      "additionalProperties": false
    },
    "membership": {
      "type": "object",
      "required": ["predicate", "ref", "scalar_kind", "values"],
      "properties": {
        "predicate": {"const": "membership"},
        "ref": {"type": "string", "minLength": 1},
        "scalar_kind": {"enum": ["number", "string", "boolean"]},
        "values": {"type": "array"}
      },
      "allOf": [
        {
          "if": {"properties": {"scalar_kind": {"const": "number"}}, "required": ["scalar_kind"]},
          "then": {"properties": {"values": {"items": {"type": "number"}}}}
        },
        {
          "if": {"properties": {"scalar_kind": {"const": "string"}}, "required": ["scalar_kind"]},
          "then": {"properties": {"values": {"items": {"type": "string"}}}}
        },
        {
          "if": {"properties": {"scalar_kind": {"const": "boolean"}}, "required": ["scalar_kind"]},
          "then": {"properties": {"values": {"items": {"type": "boolean"}}}}
        }
      ],
      "additionalProperties": false
    },
    "exists": {
      "type": "object",
      "required": ["predicate", "ref"],
      "properties": {
        "predicate": {"const": "exists"},
        "ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "andOr": {
      "type": "object",
      "required": ["predicate", "operands"],
      "properties": {
        "predicate": {"enum": ["and", "or"]},
        "operands": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/predicate"}
        }
      },
      "additionalProperties": false
    },
    "not": {
      "type": "object",
      "required": ["predicate", "operand"],
      "properties": {
        "predicate": {"const": "not"},
        "operand": {"$ref": "#/$defs/predicate"}
      },
      "additionalProperties": false
    },
    "predicate": {
      "oneOf": [
        {"$ref": "#/$defs/compare"},
        {"$ref": "#/$defs/membership"},
        {"$ref": "#/$defs/exists"},
        {"$ref": "#/$defs/andOr"},
        {"$ref": "#/$defs/not"}
      ]
    }
  },
  "$ref": "#/$defs/predicate"
}

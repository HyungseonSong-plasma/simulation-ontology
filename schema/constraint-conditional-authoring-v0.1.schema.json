{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulation-ontology.example/schema/constraint-conditional-authoring-v0.1.schema.json",
  "title": "SOL Conditional Constraint Authoring v0.1",
  "description": "ADR-0023 Conditional authoring syntax. Consequents reference the five accepted ordinary Constraint families and cannot nest Conditional.",
  "$defs": {
    "ordinaryConstraint": {
      "oneOf": [
        {"$ref": "constraint-cardinality-authoring-v0.1.schema.json"},
        {"$ref": "constraint-type-authoring-v0.1.schema.json"},
        {"$ref": "constraint-value-authoring-v0.1.schema.json"},
        {"$ref": "constraint-dimension-authoring-v0.1.schema.json"},
        {"$ref": "constraint-compatibility-authoring-v0.1.schema.json"}
      ]
    }
  },
  "type": "object",
  "required": ["type", "if", "then"],
  "properties": {
    "type": {"const": "conditional"},
    "if": {"$ref": "predicate-authoring-v0.1.schema.json"},
    "then": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ordinaryConstraint"}
    }
  },
  "additionalProperties": false
}

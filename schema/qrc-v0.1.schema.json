{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulation-ontology.example/schema/qrc-v0.1.schema.json",
  "title": "SOL Qualified Relation Cardinality v0.1",
  "type": "object",
  "required": ["type", "relation"],
  "properties": {
    "type": {"const": "cardinality"},
    "relation": {"type": "string", "minLength": 1},
    "qualifier": {
      "type": "object",
      "required": ["target_type"],
      "properties": {"target_type": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "min": {"type": "integer", "minimum": 0},
    "max": {"type": "integer", "minimum": 0},
    "exact": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}

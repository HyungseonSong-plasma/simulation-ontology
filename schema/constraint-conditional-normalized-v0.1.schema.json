{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulation-ontology.example/schema/constraint-conditional-normalized-v0.1.schema.json",
  "title": "SOL Normalized Conditional Constraint v0.1",
  "description": "Canonical ADR-0023 Conditional payload over normalized Predicate and ordinary Constraint schemas.",
  "$defs": {
    "ordinaryConstraint": {
      "oneOf": [
        {"$ref": "constraint-cardinality-normalized-v0.1.schema.json"},
        {"$ref": "constraint-type-normalized-v0.1.schema.json"},
        {"$ref": "constraint-value-normalized-v0.1.schema.json"},
        {"$ref": "constraint-dimension-normalized-v0.1.schema.json"},
        {"$ref": "constraint-compatibility-normalized-v0.1.schema.json"}
      ]
    }
  },
  "type": "object",
  "required": ["type", "if", "then"],
  "properties": {
    "type": {"const": "conditional"},
    "if": {"$ref": "predicate-normalized-v0.1.schema.json"},
    "then": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ordinaryConstraint"}
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulation-ontology.example/schema/mapping-contract-v0.1.schema.json",
  "title": "SOL Mapping Contract Harness v0.2",
  "$defs": {
    "MappingRule": {
      "type": "object",
      "required": ["source", "applicability", "realization", "bindings", "capabilities"],
      "properties": {"source": {}, "applicability": {}, "realization": {}, "bindings": {}, "capabilities": {}},
      "additionalProperties": false
    },
    "MappingClaim": {
      "type": "object",
      "required": ["obligation", "source", "realization", "provenance"],
      "properties": {"obligation": {}, "source": {}, "realization": {}, "provenance": {}},
      "additionalProperties": false
    },
    "ComponentBinding": {
      "type": "object",
      "required": ["component_id", "adapter_contract_id", "adapter_contract_version"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "adapter_contract_id": {"type": "string", "minLength": 1},
        "adapter_contract_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "RealizationEffect": {
      "type": "object",
      "required": ["id", "kind", "operation", "resource", "resource_component_id", "fingerprint", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1}, "resource": {"type": "string", "minLength": 1},
        "resource_component_id": {"type": "string", "minLength": 1}, "path": {"type": ["string", "null"]},
        "scope": {}, "fingerprint": {"type": "string", "minLength": 1}, "provenance": {}
      },
      "additionalProperties": false
    },
    "ExecutableDescriptor": {
      "type": "object",
      "required": ["descriptor_id", "descriptor_kind", "component_id"],
      "properties": {
        "descriptor_id": {"type": "string", "minLength": 1},
        "descriptor_kind": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "atomic": {"type": "boolean"},
        "parameters": {}
      },
      "additionalProperties": false
    },
    "StateIndependentIdempotency": {
      "type": "object",
      "required": ["mode", "descriptor_kind"],
      "properties": {"mode": {"const": "state_independent"}, "descriptor_kind": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "StateDependentIdempotency": {
      "type": "object",
      "required": ["mode", "procedure_id", "procedure_version"],
      "properties": {
        "mode": {"const": "state_dependent"},
        "procedure_id": {"type": "string", "minLength": 1},
        "procedure_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "IdempotencyContract": {"oneOf": [{"$ref": "#/$defs/StateIndependentIdempotency"}, {"$ref": "#/$defs/StateDependentIdempotency"}]},
    "PlanAction": {
      "type": "object",
      "required": ["id", "descriptor", "requires", "produces", "effects", "component_id", "idempotency"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "descriptor": {"$ref": "#/$defs/ExecutableDescriptor"},
        "requires": {"type": "array", "items": {"type": "string"}}, "produces": {"type": "array", "items": {"type": "string"}},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/RealizationEffect"}}, "component_id": {"type": "string", "minLength": 1},
        "idempotency": {"$ref": "#/$defs/IdempotencyContract"}
      },
      "additionalProperties": false
    },
    "ComparatorRegistryEntry": {
      "type": "object",
      "required": ["id", "version", "scope", "directionality", "comparison_purpose", "left_kind", "right_kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "scope": {"enum": ["local", "cross_component"]}, "directionality": {"enum": ["symmetric", "directional"]},
        "component_binding": {"$ref": "#/$defs/ComponentBinding"},
        "left_component_binding": {"$ref": "#/$defs/ComponentBinding"}, "right_component_binding": {"$ref": "#/$defs/ComponentBinding"},
        "orchestration_component_binding": {"$ref": "#/$defs/ComponentBinding"},
        "comparison_purpose": {"type": "string", "minLength": 1}, "left_kind": {"type": "string", "minLength": 1}, "right_kind": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "local"}}, "required": ["scope"]}, "then": {"required": ["component_binding"], "not": {"anyOf": [{"required": ["left_component_binding"]}, {"required": ["right_component_binding"]}, {"required": ["orchestration_component_binding"]}]}}},
        {"if": {"properties": {"scope": {"const": "cross_component"}}, "required": ["scope"]}, "then": {"required": ["left_component_binding", "right_component_binding", "orchestration_component_binding"], "not": {"required": ["component_binding"]}}}
      ],
      "additionalProperties": false
    },
    "DisjointnessEvidence": {
      "type": "object",
      "required": ["effect_pair", "decision", "resource_relation", "scope_overlap", "comparator_id", "comparator_version", "target_snapshot_fingerprint", "input_fingerprints"],
      "properties": {
        "effect_pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "decision": {"enum": ["PASS", "FAIL", "BLOCKED", "INDETERMINATE"]},
        "resource_relation": {"enum": ["same", "separate", "overlapping", "unresolved"]},
        "scope_overlap": {"type": ["boolean", "null"]}, "comparator_id": {"type": "string", "minLength": 1},
        "comparator_version": {"type": "string", "minLength": 1}, "target_snapshot_fingerprint": {"type": "string", "minLength": 1},
        "input_fingerprints": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "BackendTargetComponentRequirement": {
      "type": "object",
      "required": ["component_id", "adapter_contract", "release_compatibility", "required_capabilities", "formulation_bindings"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "adapter_contract": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
        "release_compatibility": {"type": "object", "properties": {"allowed": {"type": "array", "items": {"type": "string"}, "minItems": 1}}, "additionalProperties": false},
        "required_capabilities": {"type": "array", "items": {"type": "string"}},
        "formulation_bindings": {"type": "array", "items": {"type": "object", "required": ["sol_obligation", "backend_formulation"], "properties": {"sol_obligation": {"type": "string", "minLength": 1}, "backend_formulation": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "BackendTargetRequirement": {"type": "object", "required": ["components"], "properties": {"components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/BackendTargetComponentRequirement"}}, "orchestration_component_id": {"type": ["string", "null"]}}, "additionalProperties": false},
    "ResolvedBackendTargetComponent": {
      "type": "object",
      "required": ["component_id", "adapter_contract", "adapter_build_identity", "actual_release", "capabilities", "available_formulations"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "adapter_contract": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
        "adapter_build_identity": {"type": "string", "minLength": 1}, "actual_release": {"type": ["string", "null"]},
        "capabilities": {"type": ["array", "null"], "items": {"type": "string"}}, "available_formulations": {"type": ["array", "null"], "items": {"type": "string"}},
        "orchestration_capable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ResolvedBackendTarget": {"type": "object", "required": ["components", "resolution_provenance"], "properties": {"components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ResolvedBackendTargetComponent"}}, "resolution_provenance": {}}, "additionalProperties": false},
    "EvaluationRecord": {
      "type": "object", "required": ["revision_id", "state", "validation_decision"],
      "properties": {
        "revision_id": {"type": "string", "minLength": 1}, "prior_revision_id": {"type": ["string", "null"]}, "target_snapshot_fingerprint": {"type": ["string", "null"]},
        "state": {"enum": ["pending", "blocked", "indeterminate", "complete"]}, "validation_decision": {"enum": ["PASS", "FAIL", "BLOCKED", "INDETERMINATE"]},
        "representability": {"enum": ["exact", "transformed", "lossy", "unsupported"]}, "execution_permission": {"enum": ["permitted", "prohibited"]}
      }, "additionalProperties": false
    }
  }
}

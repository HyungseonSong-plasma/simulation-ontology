{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulation-ontology.example/schema/resolved-model-snapshot-v0.1.schema.json",
  "title": "SOL Resolved Model Snapshot v0.1",
  "description": "Focused closed normalized model-instance snapshot for ADR-0029 design-stage reference validation.",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "packageIdentity": {
      "type": "object",
      "required": ["package", "version"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/semver"}
      },
      "additionalProperties": false
    },
    "canonicalReference": {
      "type": "string",
      "pattern": "^https://simulation-ontology\\.org/id/.+$"
    },
    "modelInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "propertyAssignment": {
      "type": "object",
      "required": ["property", "value_definition"],
      "properties": {
        "property": {"$ref": "#/$defs/canonicalReference"},
        "value_definition": {"$ref": "value-definition-inline-v0.1.schema.json"}
      },
      "additionalProperties": false
    },
    "entityInstance": {
      "type": "object",
      "required": ["id", "type", "properties"],
      "properties": {
        "id": {"$ref": "#/$defs/modelInstanceId"},
        "type": {"$ref": "#/$defs/canonicalReference"},
        "properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/propertyAssignment"}
        }
      },
      "additionalProperties": false
    },
    "relationEdge": {
      "type": "object",
      "required": ["relation", "source", "target"],
      "properties": {
        "relation": {"$ref": "#/$defs/canonicalReference"},
        "source": {"$ref": "#/$defs/modelInstanceId"},
        "target": {"$ref": "#/$defs/modelInstanceId"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["snapshot_state", "ontology_environment", "entities", "relations"],
  "properties": {
    "snapshot_state": {"const": "closed"},
    "ontology_environment": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packageIdentity"}
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entityInstance"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationEdge"}
    }
  },
  "additionalProperties": false
}

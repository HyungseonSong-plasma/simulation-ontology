{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOL bounded field JSON payload profile v1 (interchange, not canonical identity)",
  "type": "object",
  "required": [
    "profile",
    "coordinates",
    "cells",
    "support_indices",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "sol.field-json.v1"
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "vertices"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "line2",
              "tri3",
              "quad4"
            ]
          },
          "vertices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "support_indices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    }
  }
}

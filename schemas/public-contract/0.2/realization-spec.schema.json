{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOL Public Contract 0.2 RealizationSpecDto",
  "type": "object",
  "required": [
    "public_contract_version",
    "ontology_version",
    "source_model",
    "entities",
    "scopes",
    "relations",
    "action_bindings"
  ],
  "properties": {
    "public_contract_version": { "$ref": "shared.schema.json#/$defs/publicContractVersion" },
    "ontology_version": { "type": "string", "minLength": 1 },
    "source_model": { "$ref": "shared.schema.json#/$defs/canonicalReference" },
    "entities": {
      "type": "array",
      "items": { "$ref": "shared.schema.json#/$defs/realizationEntity" }
    },
    "scopes": {
      "type": "array",
      "items": { "$ref": "shared.schema.json#/$defs/spatialScope" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "shared.schema.json#/$defs/semanticRelation" }
    },
    "action_bindings": {
      "type": "array",
      "items": { "$ref": "shared.schema.json#/$defs/actionRealizationBinding" }
    }
  }
}

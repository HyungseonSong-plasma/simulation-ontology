{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOL Adapter Protocol 0.1 ExecutePlanResponse",
  "type": "object",
  "required": [
    "adapter_protocol_version",
    "execution",
    "action_reports"
  ],
  "properties": {
    "adapter_protocol_version": { "$ref": "shared.schema.json#/$defs/adapterProtocolVersion" },
    "execution": {
      "type": "string",
      "enum": ["completed", "partial", "failed", "rejected", "unavailable"]
    },
    "execution_batches": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "shared.schema.json#/$defs/stableSymbol" }
      }
    },
    "action_reports": {
      "type": "array",
      "items": { "$ref": "shared.schema.json#/$defs/actionExecutionReport" }
    },
    "effects": {
      "type": "array",
      "items": { "$ref": "../../public-contract/0.1/shared.schema.json#/$defs/realizationEffect" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "../../public-contract/0.1/shared.schema.json#/$defs/diagnostic" }
    },
    "provenance": { "$ref": "shared.schema.json#/$defs/executionProvenance" }
  }
}

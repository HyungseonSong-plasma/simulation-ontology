{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOL Adapter Protocol 0.2 shared definitions",
  "$defs": {
    "adapterProtocolVersion": {
      "type": "string",
      "const": "0.2"
    },
    "majorMinorVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
